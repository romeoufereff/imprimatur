{
  "$comment": [
    "Generated by design-system-forge from (authored — no source artefact).",
    "Every token here traces to an observation recorded in PROVENANCE.md. Values marked",
    "there as inferred (rather than declared by the source's theme) deserve a human look",
    "before this pack is trusted for client-facing work."
  ],
  "contractVersion": "1.0",
  "id": "acme",
  "name": "ACME Deck System",
  "version": "1.0",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "tokens": {
    "prefix": "acme",
    "configFile": "tailwind.config.js",
    "baseFile": "slide-base.html",
    "templatesDir": "templates"
  },
  "typography": {
    "minFontSizePx": 24,
    "allowedWeights": [
      400,
      500,
      600,
      700
    ],
    "fontUtilityClass": "font-acme",
    "familyRequiredPattern": "Barlow",
    "familyMarker": "Barlow",
    "familyLabel": "Barlow / Barlow Condensed"
  },
  "footer": {
    "requiredText": "",
    "label": ""
  },
  "gradients": {
    "brandHexMarkers": [],
    "canonical": []
  },
  "palette": {
    "censusExcludesInlineConfig": true,
    "censusSources": [
      "tailwind.config.js",
      "slide-base.html",
      "templates/*.html"
    ]
  },
  "roles": {
    "primary": "primary",
    "primary-mid": "primary-mid",
    "accent": "accent",
    "deep": "deep",
    "support-1": "support-1",
    "support-2": "support-2",
    "ink": "ink",
    "body": "body",
    "muted": "muted",
    "muted-soft": "muted-soft",
    "rule": "rule",
    "rule-neutral": "rule",
    "tint": "tint",
    "surface": "surface",
    "white": "white",
    "viz": [
      "primary",
      "primary-mid",
      "deep",
      "support-1",
      "muted-soft"
    ],
    "vizExtended": [
      "accent",
      "support-2"
    ]
  },
  "rules": {
    "requireSlideCanvas": true,
    "requireInlineTailwindConfig": true,
    "requireFooterText": false,
    "requireFontMarker": true,
    "requireCanonicalScaler": true,
    "requireDataTemplate": true,
    "enforceFontSizeFloor": true,
    "enforceTokenValues": true,
    "enforceGradientCanon": false,
    "enforcePaletteCensus": true,
    "banTailwindDefaultPalette": true,
    "banOffScaleFontWeights": true,
    "banOffBrandFontFamilies": true,
    "banEmoji": true,
    "banStructuralShadows": true,
    "banLeftAccentBars": true,
    "banElementCollisions": true,
    "checkFontUrlsResolve": false
  },
  "collisionTolerancePx": 4,
  "licensing": {
    "assetsRedistributable": true,
    "note": "Original work created with Claude Design, no client brand involved. Safe to redistribute under the engine's MIT terms."
  },
  "svg": {
    "fontStack": "Barlow, system-ui, sans-serif",
    "iconStrokeWidth": 1.5,
    "minBodyPx": 28,
    "minLabelPx": 24,
    "minCaptionPx": 24
  },
  "pptx": {
    "fontFamilyByWeight": {
      "400": "Barlow",
      "500": "Barlow Medium",
      "600": "Barlow Condensed SemiBold",
      "700": "Barlow Bold"
    }
  },
  "charts": {
    "library": "echarts",
    "requiredMarker": "colorStops",
    "message": "ECharts present without colorStops — set colorStops from the viz role"
  },
  "iconPolicy": "Outline SVG only",
  "editor": {
    "gridPx": 24,
    "spacingSteps": [
      0,
      24,
      48,
      72,
      96,
      120,
      144,
      192,
      240
    ]
  }
}
