{
  "id": "starter", "name": "Imprimatur Starter", "version": "1.0",
  "canvas": {"width": 1920, "height": 1080},
  "tokens": {
    "prefix": "ds",
    "colors": {
      "primary":    "#2B59C3",
      "primary-mid":"#3F7FD1",
      "accent":     "#6E4BB8",
      "deep":       "#1B3A8C",
      "teal":       "#157F79",
      "cyan":       "#0E7490",
      "ink":        "#14181F",
      "body":       "#3A4150",
      "muted":      "#5E6675",
      "muted-soft": "#8A92A0",
      "rule":       "#D7DBE2",
      "tint":       "#EEF2FB",
      "surface":    "#F4F6F9",
      "white":      "#FFFFFF"
    }
  },
  "roles": {
    "primary": "primary", "primary-mid": "primary-mid", "accent": "accent", "deep": "deep",
    "support-1": "teal", "support-2": "cyan",
    "ink": "ink", "body": "body", "muted": "muted", "muted-soft": "muted-soft",
    "rule": "rule", "rule-neutral": "rule", "tint": "tint", "surface": "surface",
    "viz": ["primary", "teal", "accent", "deep", "muted"],
    "vizExtended": ["cyan", "primary-mid", "muted-soft"]
  },
  "typography": {
    "familyLabel": "System Sans",
    "familyMarker": "system-ui",
    "familyRequiredPattern": "system-ui",
    "fontUtilityClass": "font-ds",
    "stack": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
    "allowedWeights": [300, 400, 700],
    "minFontSizePx": 14
  },
  "typeScale": {
    "display": {"size": "88px", "lineHeight": "1.05", "fontWeight": "300"},
    "section": {"size": "86px", "lineHeight": "1.05", "fontWeight": "300"},
    "title":   {"size": "54px", "lineHeight": "1.1",  "fontWeight": "700"},
    "h2":      {"size": "46px", "lineHeight": "1.15", "fontWeight": "700"},
    "h3":      {"size": "37px", "lineHeight": "1.2",  "fontWeight": "700"},
    "metric":  {"size": "44px", "lineHeight": "1.1",  "fontWeight": "700"},
    "lead":    {"size": "27px", "lineHeight": "1.5",  "fontWeight": "400"},
    "subhead": {"size": "25px", "lineHeight": "1.3",  "fontWeight": "700"},
    "body-sm": {"size": "20px", "lineHeight": "1.5",  "fontWeight": "400"},
    "label":   {"size": "18px", "lineHeight": "1.4",  "fontWeight": "400"},
    "eyebrow": {"size": "16px", "lineHeight": "1.4",  "fontWeight": "700"},
    "caption": {"size": "14px", "lineHeight": "1.4",  "fontWeight": "400"}
  },
  "gradients": {
    "brand":   "linear-gradient(60deg, #3F7FD1 0%, #2B59C3 55%, #6E4BB8 100%)",
    "section": "linear-gradient(170deg, #3F7FD1 0%, #2B59C3 55%, #6E4BB8 100%)"
  },
  "gradientMarkers": ["#3F7FD1", "#6E4BB8"],
  "tracking": {"eyebrow": "0.22em", "label": "0.10em"},
  "radii": {"sm": "8px", "md": "16px", "pill": "9999px"},
  "footer": {"requiredText": "Confidential", "label": "Confidential."},
  "iconPolicy": "Outline SVG only",
  "charts": {"library": "echarts", "requiredMarker": "colorStops",
             "message": "ECharts present without colorStops — the default palette is off-brand; set colorStops from the viz role"},
  "svg": {"fontStack": "system-ui, -apple-system, sans-serif", "iconStrokeWidth": 1.8,
          "minBodyPx": 20, "minLabelPx": 16, "minCaptionPx": 14},
  "pptx": {"fontFamilyByWeight": {"300": "Helvetica Neue Light", "400": "Helvetica Neue", "700": "Helvetica Neue Bold"}},
  "editor": {"gridPx": 8, "spacingSteps": [0, 8, 16, 24, 32, 40, 48, 64, 80]},
  "rules": {"checkFontUrlsResolve": false},
  "licensing": {"assetsRedistributable": true,
                "note": "Neutral starter pack — no third-party fonts or trademarks. Safe to redistribute; replace it with a real brand pack for client work."}
}
